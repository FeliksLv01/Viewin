// Shared app identity and version. Update these values for future releases.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

PRODUCT_NAME = Viewin
PRODUCT_BUNDLE_IDENTIFIER = com.felikslv.Viewin
INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_NAME)

// Shared icon for Debug and Release.
ASSETCATALOG_COMPILER_APPICON_NAME = ViewinIcon

// Document registration is merged with Xcode-generated bundle keys.
INFOPLIST_FILE = Config/Info.plist

// Persist only the directories the user authorizes for Skill installation.
CODE_SIGN_ENTITLEMENTS = Config/Viewin.entitlements
// The CLI packaging phase invokes SwiftPM; the app itself remains sandboxed.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Public feed and verification key. Private signing keys never belong here.
VIEWIN_UPDATE_FEED_URL = https:/$()/github.com/FeliksLv01/Viewin/releases/latest/download/appcast.xml
VIEWIN_UPDATE_PUBLIC_KEY = 8mj5GQuapgrpB0pES0+wBCCyhJhsmoT3Yv0vJ13kKVk=
VIEWIN_ENABLE_UPDATES = YES
ENABLE_HARDENED_RUNTIME = YES
